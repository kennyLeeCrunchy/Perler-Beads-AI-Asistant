DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_MODEL=wan2.6-t2i
DASHSCOPE_I2I_MODEL=wan2.5-i2i-preview
DASHSCOPE_IMAGE_SIZE=1280*1280
PINDOU_I2I_TIMEOUT=240
# 可选：上传、生成与导出文件目录；默认使用项目下的 runtime。
PINDOU_RUNTIME_DIR=
# 逗号分隔的前端来源白名单；分离部署或局域网调试时按实际地址填写。
PINDOU_CORS_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
# 局域网调试时追加 http://你的局域网IP:5180；不要把密钥写入前端。
